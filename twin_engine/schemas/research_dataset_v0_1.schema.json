{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmycure4mm.local/schemas/research_dataset_v0_1.schema.json",
  "title": "bmyCure4MM private structured research dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "case_ref",
    "created_at",
    "sources",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{2,127}$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "case_ref": {
      "type": "string",
      "pattern": "^MM_RESEARCH_CASE_[0-9]{3,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC_[A-Z0-9_.-]+$"
        },
        "source_type": {
          "type": "string"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "provenance_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "source_id",
        "source_locator",
        "source_sha256",
        "extraction_method",
        "technical_validation_status",
        "clinical_validation_status",
        "source_quality",
        "epistemic_class"
      ],
      "properties": {
        "assertion_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_locator": {
          "type": ["string", "null"]
        },
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "extraction_method": {
          "enum": [
            "manual_verified",
            "ai_suggested_human_verified",
            "legacy_manual_extraction"
          ]
        },
        "technical_validation_status": {
          "enum": [
            "validated",
            "pending",
            "failed",
            "legacy_unverified"
          ]
        },
        "clinical_validation_status": {
          "enum": [
            "not_required",
            "pending",
            "validated",
            "disputed"
          ]
        },
        "source_quality": {
          "type": "string"
        },
        "epistemic_class": {
          "enum": [
            "observed",
            "derived",
            "inferred",
            "simulated",
            "hypothetical"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "identity",
        "payload",
        "provenance"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "record_type": {
          "enum": [
            "lab_result",
            "assessment",
            "therapy_course",
            "therapy_interruption",
            "adverse_event"
          ]
        },
        "identity": {
          "type": "object",
          "minProperties": 1
        },
        "payload": {
          "type": "object"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance_assertion"
          }
        }
      }
    }
  }
}
